@model Book

@{
    ViewData["Title"] = "Confirm deletion";
}

<div class="text-center">
    <h1 class="display-4">Confirm deletion</h1>
    <p>@ViewData["BookTitle"]</p>
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Author)</th>
            </tr>
            <tr>
               <td>@Model.Id</td> 
               <td>@Model.Title</td> 
               <td>@Model.Author</td> 
            </tr>
        </thead>
        <tbody>
            <tr>
                <th>Item Id</th>
                <th>Copy Id</th>
                <th>Action</th>
            </tr>
            <tr>
                <td>Dummy book 1</td>
                <td>Copy 1</td>
                <td>Delete copy</td>
            </tr>
            <tr>
                <td>Dummy book 2</td>
                <td>Copy 2</td>
                <td>Delete copy</td>
            </tr>
            <tr>
                <td>Dummy book 3</td>
                <td>Copy 3</td>
                <td>Delete copy</td>
            </tr>
        </tbody>
    </table>
    <form asp-action="DeleteBook">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirm deletion" class="btn btn-danger" /> 
    </form>
    </div>
</div>