@model Bookish.ViewModels.BookViewModel;


@{
    ViewData["Title"] = "Confirm deletion";
}

<div class="text-center">
    <h1 class="display-4">Confirm deletion</h1>
    <p>@ViewData["BookTitle"]</p>
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Author)</th>
            </tr>
            <tr>
               <td>@Model.Id</td> 
               <td>@Model.Title</td> 
               <td>@Model.Author</td> 
            </tr>
        </thead>
        <tbody>
            <tr>
                <th>Item Id</th>
                <th>Copy Number</th>
                <th>Status</th>
            </tr>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>Copy Id</td>
                <td>@if (item.User == null)
                {
                    <span>Available</span>
                }
                else
                    {
                    <span>On loan to @item.User)</span>
                }
                </td>
        </tr>
        }
        </tbody>
    </table>
    <form asp-action="DeleteBook">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirm deletion" class="btn btn-danger" /> 
    </form>
    </div>

</div>